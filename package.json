{
  "name": "toolifylab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:pwa": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postbuild": "next-sitemap",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit fix",
    "security": "pnpm audit --audit-level=moderate",
    "safe-upgrade": "npx npm-check-updates -u -t minor && pnpm install",
    "migrate": "pnpm dlx shadcn@latest migrate radix",
    "migrate:tailwind": "pnpm dlx @tailwindcss/upgrade --force",
    "validate": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run audit",
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@google/genai": "^2.30.0",
    "@hookform/resolvers": "^5.9.2",
    "@serwist/next": "^9.5.13",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "exifr": "^7.1.3",
    "highlight.js": "^11.12.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "latest",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.90.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "remove-markdown": "^0.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/estree": "^1.0.9",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.13",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": ["eslint --fix --no-warn-ignored", "prettier --write"],
    "*.{json,md,css,html}": ["prettier --write"]
  }
}
